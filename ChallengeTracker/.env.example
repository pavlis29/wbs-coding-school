# Only for Docker Compose. Copy to .env and fill with your OWN values.
# Prefer ./scripts/configure-docker.sh to generate both values correctly.
# For JWT_KEY you can also use: openssl rand -hex 32
JWT_KEY=
# At least 8 chars, upper/lower case, digits and symbols. Do not use semicolons.
MSSQL_SA_PASSWORD=
FRONTEND_ORIGIN=http://localhost:5173
