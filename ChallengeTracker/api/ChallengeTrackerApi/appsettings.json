{
  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "DefaultConnection": "Data Source=challenge.db" },
  "Jwt": { "Issuer": "ChallengeTracker", "Audience": "ChallengeTracker", "LifetimeMinutes": 120 },
  "Cors": { "AllowedOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"] },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" } },
    "WriteTo": [{ "Name": "Console" }]
  },
  "AllowedHosts": "*"
}
